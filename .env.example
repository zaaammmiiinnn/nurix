# ─────────────────────────────────────────────────────────────────────────────
# NEURALWAVES (.env.example) — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# 1. Supabase Database & Auth (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Resend Inbound Email Alerts (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Meta WhatsApp Cloud API (https://developers.facebook.com)
# E.164 phone number without plus sign (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="971501234567"
# System User Access Token with whatsapp_business_messaging & whatsapp_business_management
WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Phone Number ID from WhatsApp Getting Started tab
PHONE_NUMBER_ID="100000000000000"
# Secret verification token for GET /api/whatsapp/webhook
VERIFY_TOKEN="neuralwaves_wa_secret_verify_token_2026"

# 4. Site Configuration & Custom Domains
NEXT_PUBLIC_SITE_URL="https://neuralwaves.in"
NEXT_PUBLIC_CAL_COM_URL="https://cal.com/neuralwaves/15min"

# 5. Admin & Notification Operations
ADMIN_EMAIL="admin@neuralwaves.in"

# 6. Optional: Vercel Cron Job Secret (for /api/cron/lead-digest)
CRON_SECRET="cr_secret_token_xxxxxxxxxxxx"
