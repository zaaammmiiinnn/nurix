# ─────────────────────────────────────────────────────────────────────────────
# NEURALWAVES (.env.example) — Environment Variables
#
# Copy to .env.local for development. In production these are Cloudflare Worker
# secrets (via `npx wrangler secret put NAME`), not a .env file.
#
# Names here MUST match what the code actually reads. Use lib/config.ts as the
# single source of truth.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Clerk Authentication (https://dashboard.clerk.com -> API Keys)
# Required for admin panel authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/admin"

# Comma-separated allowlist of VERIFIED admin email addresses.
# REQUIRED — the admin check fails closed, so with this unset nobody can sign in.
# Do NOT commit real addresses; they live only in the environment.
ADMIN_EMAILS="admin@example.com,owner@example.com"
# Optional single-address fallback (also accepted by is_email_authorized_admin).
ADMIN_EMAIL="admin@example.com"

# 2. Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
# New-style publishable key (or the legacy anon JWT). Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# Optional alias accepted by lib/supabase/*; set it to the same value if you use it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. REQUIRED for the admin panel — it bypasses RLS. Never expose this
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# 3. Resend transactional email (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Sender. Must be a verified domain in Resend to send to arbitrary recipients.
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Where lead notifications and the weekly digest are sent.
RESEND_TO_EMAIL="admin@example.com"

# 4. Meta WhatsApp Cloud API (https://developers.facebook.com)
# E.164 phone number without the plus sign, e.g. 9715XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER="9715XXXXXXXX"
# System User Access Token with whatsapp_business_messaging permission.
# REQUIRED for outbound replies — without it the webhook can only receive.
WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Phone Number ID from the WhatsApp "Getting Started" tab. Required for outbound.
PHONE_NUMBER_ID="100000000000000"
# Arbitrary secret you choose; entered in the Meta webhook setup screen and
# checked by GET /api/whatsapp/webhook. Generate one, do not reuse a public value.
VERIFY_TOKEN="change-me-to-a-random-secret"
# Meta app secret (Meta dashboard -> Settings -> Basic -> App Secret).
# REQUIRED: POST /api/whatsapp/webhook rejects unsigned requests. Without this the
# webhook returns 401 for every delivery.
META_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 5. Site configuration
NEXT_PUBLIC_SITE_URL="https://neuralwaves.in"
NEXT_PUBLIC_CAL_COM_URL="https://cal.com/neuralwaves/15min"

# 6. Cron authentication for /api/cron/lead-digest
# REQUIRED — the endpoint refuses to run (503) when this is unset, and returns
# 401 for a wrong bearer token. Generate with: openssl rand -hex 32
# On Cloudflare, the Cron Trigger sends this as an Authorization header only if
# you add it in the Worker; otherwise call the endpoint from a scheduled handler.
CRON_SECRET=""
