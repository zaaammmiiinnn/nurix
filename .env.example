# ─────────────────────────────────────────────────────────────────────────────
# NEURALWAVES (.env.example) — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# 1. Clerk Authentication (https://dashboard.clerk.com/ -> API Keys)
# Required for Admin Panel authentication and verified user access control
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/admin"
# Comma-separated list of verified admin email addresses allowed to access the admin portal
ADMIN_EMAILS="zaminaskari.work@gmail.com,askarizamin110@gmail.com"

# 2. Supabase Database & Auth (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Resend Inbound Email Alerts (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Meta WhatsApp Cloud API (https://developers.facebook.com)
# E.164 phone number without plus sign (e.g. 918840936715)
NEXT_PUBLIC_WHATSAPP_NUMBER="918840936715"
# System User Access Token with whatsapp_business_messaging & whatsapp_business_management
WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Phone Number ID from WhatsApp Getting Started tab
PHONE_NUMBER_ID="100000000000000"
# Secret verification token for GET /api/whatsapp/webhook
VERIFY_TOKEN="neuralwaves_wa_secret_verify_token_2026"

# 5. Site Configuration & Custom Domains
NEXT_PUBLIC_SITE_URL="https://neuralwaves.in"
NEXT_PUBLIC_CAL_COM_URL="https://cal.com/neuralwaves/15min"

# 6. Admin & Notification Operations
ADMIN_EMAIL="zaminaskari.work@gmail.com"

# 7. Optional: Vercel Cron Job Secret (for /api/cron/lead-digest)
CRON_SECRET="cr_secret_token_xxxxxxxxxxxx"
